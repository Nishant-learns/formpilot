# FormPilot runtime configuration. Copy this file to `.env` and edit locally.
# Never commit `.env` or a real API key.

FORMPILOT_ENV=demo
FORMPILOT_DEMO_MODE=true
FORMPILOT_ENABLE_SIMULATOR=true
FORMPILOT_HOST=127.0.0.1
FORMPILOT_PORT=8000

# TinyFish. The app runs without a key using the local browser and the
# built-in portal registry; add a key to enable live search and cloud browser
# sessions. You can also save it from the in-app Connection settings dialog.
TINYFISH_API_KEY=
TINYFISH_MODE=auto
TINYFISH_PROXY_COUNTRY=IN
TINYFISH_TIMEOUT_SECONDS=90

# Verification codes are relayed through an ntfy.sh topic in the demo.
# Use a private, unguessable topic for any shared deployment.
FORMPILOT_NTFY_TOPIC=formpilot_demo_otp
FORMPILOT_DEMO_OTP=492015

# Candidate assistant model. Any OpenAI-compatible endpoint works.
# A local server (for example Ollama) needs no key:
#   FORMPILOT_LLM_BASE_URL=http://127.0.0.1:11434/v1
#   FORMPILOT_LLM_MODEL=llama3.2
# The in-app Settings dialog can also save these values on this device.
FORMPILOT_LLM_API_KEY=
FORMPILOT_LLM_BASE_URL=https://api.openai.com/v1
FORMPILOT_LLM_MODEL=gpt-4o-mini
FORMPILOT_LLM_TIMEOUT_SECONDS=45

# Optional: require a shared token for API and WebSocket access.
# FORMPILOT_AUTH_TOKEN=replace-with-a-long-random-value

# Optional: encrypt the saved candidate profile at rest (base64, 32 bytes).
# Generate one with: python scripts/generate_vault_key.py
# FORMPILOT_VAULT_KEY=

# Optional: mask sensitive values in API responses. The profile editor needs
# the unmasked values, so this is off by default for the local demo.
# FORMPILOT_MASK_PII=false
